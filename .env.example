# Conexão do banco usada pelo back-end quando roda fora do Docker (pela IDE ou mvnw).
# Com "docker compose up -d postgres", use: jdbc:postgresql://localhost:5432/tudoemdia

SPRING_DATASOURCE_URL=jdbc:postgresql://HOST_DO_BD:PORTA/NOME_DO_BD
SPRING_DATASOURCE_USERNAME=USER_DO_BD
SPRING_DATASOURCE_PASSWORD=SENHA_DO_BD

# Banco criado pelo docker-compose.yml
POSTGRES_DB=tudoemdia
POSTGRES_USER=tudoemdia
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
# POSTGRES_PORT=5432

# Front-end (CORS e links nos e-mails). Padrão: http://localhost:5173
# FRONTEND_URL=http://localhost:5173

# Pasta dos anexos e documentos. Padrão: uploads
# ARMAZENAMENTO_DIR=uploads

# E-mail (convites e alertas). Sem MAIL_HOST, as mensagens só aparecem no log.
# Com o Mailpit do docker-compose: MAIL_HOST=localhost, MAIL_PORT=1025,
# MAIL_SMTP_AUTH=false, MAIL_SMTP_STARTTLS=false; caixa de entrada em http://localhost:8025
# MAIL_HOST=smtp.exemplo.com
# MAIL_PORT=587
# MAIL_USERNAME=usuario
# MAIL_PASSWORD=senha
# MAIL_FROM=nao-responda@tudoemdia.com.br

# Produção (HTTPS, RNF13)
# SESSION_COOKIE_SECURE=true
# EXIGIR_HTTPS=true
