# Conexão do banco

SPRING_DATASOURCE_URL=jdbc:postgresql://HOST_DO_BD:PORTA/NOME_DO_BD
SPRING_DATASOURCE_USERNAME=USER_DO_BD
SPRING_DATASOURCE_PASSWORD=SENHA_DO_BD

# Front-end (CORS e links nos e-mails). Padrão: http://localhost:5173
# FRONTEND_URL=http://localhost:5173

# Pasta dos anexos e documentos. Padrão: uploads
# ARMAZENAMENTO_DIR=uploads

# E-mail (convites e alertas). Sem MAIL_HOST, as mensagens só aparecem no log.
# MAIL_HOST=smtp.exemplo.com
# MAIL_PORT=587
# MAIL_USERNAME=usuario
# MAIL_PASSWORD=senha
# MAIL_FROM=nao-responda@tudoemdia.com.br
