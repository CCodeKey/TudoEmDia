# Conexão do banco usada pelo back-end quando roda fora do Docker (pela IDE ou mvnw).
# Com "docker compose up -d postgres", use: jdbc:postgresql://localhost:5432/tudoemdia

SPRING_DATASOURCE_URL=jdbc:postgresql://HOST_DO_BD:PORTA/NOME_DO_BD
SPRING_DATASOURCE_USERNAME=USER_DO_BD
SPRING_DATASOURCE_PASSWORD=SENHA_DO_BD

# Banco criado pelo docker-compose.yml
POSTGRES_DB=tudoemdia
POSTGRES_USER=tudoemdia
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# Front-end (CORS e links nos e-mails). Padrão: http://localhost:5173
# FRONTEND_URL=http://localhost:5173

# Pasta dos anexos e documentos. Padrão: uploads
# ARMAZENAMENTO_DIR=uploads

# E-mail (boas-vindas, convites e alertas)
#
# No Docker: sem nada configurado, tudo vai para o Mailpit (http://localhost:8025) e NÃO chega
# às caixas reais. Para enviar de verdade (ex.: Umbler, porta 587 com STARTTLS; não aceita SSL):
# SMTP_HOST=smtp.umbler.com
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# MAIL_USERNAME=contato@seudominio.com.br
# MAIL_PASSWORD=senha-da-caixa
# MAIL_FROM=contato@seudominio.com.br
#
# Back-end pela IDE: sem MAIL_HOST, as mensagens só aparecem no log. Para usar o Mailpit do Docker:
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false

# Produção (HTTPS, RNF13)
# SESSION_COOKIE_SECURE=true
# EXIGIR_HTTPS=true

# Proteção CSRF: desligada por padrão durante o desenvolvimento; ligar antes de produção
# CSRF_HABILITADO=true
